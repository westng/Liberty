{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liberty.local/schemas/asr-benchmark-manifest/v1.json",
  "title": "Liberty ASR benchmark local manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusVersion", "annotationVersion", "deviceId", "samples", "engines"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusVersion": { "type": "string", "minLength": 1 },
    "annotationVersion": { "type": "string", "minLength": 1 },
    "deviceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenarios", "language", "expectedSpeakerCount", "speakerRequired", "media", "annotation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["short_meeting", "long_meeting", "overlapping_speakers", "noise", "mixed_zh_en", "chinese_numbers"]
            }
          },
          "language": { "type": "string", "minLength": 1 },
          "expectedSpeakerCount": { "type": "integer", "minimum": 1 },
          "speakerRequired": { "type": "boolean" },
          "media": { "$ref": "#/$defs/hashedFile" },
          "annotation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "version"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "engines": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "id", "backend", "runtimeVersion", "modelSetVersion", "command", "installRoot"],
        "properties": {
          "role": { "enum": ["baseline", "candidate"] },
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "backend": { "enum": ["funasr", "sherpa-onnx"] },
          "runtimeVersion": { "type": "string", "minLength": 1 },
          "modelSetVersion": { "type": "string", "minLength": 1 },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "workingDirectory": { "type": "string", "minLength": 1 },
          "installRoot": { "type": "string", "minLength": 1 },
          "environment": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "hashedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}

{
  "name": "liberty-workspace",
  "private": true,
  "version": "1.1.24",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "scripts": {
    "check": "pnpm check:fast && pnpm desktop:build:web && pnpm rust:clippy && pnpm release:check",
    "check:fast": "pnpm contracts:check && pnpm desktop:typecheck && pnpm desktop:test && pnpm python:lint && pnpm python:test && pnpm rust:fmt:check && pnpm rust:test",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "security:check": "node scripts/check-dependency-governance.mjs security",
    "licenses:check": "node scripts/check-dependency-governance.mjs licenses",
    "security:test": "node scripts/test-dependency-governance.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "asr:fixtures:check": "node scripts/check-asr-fixtures.mjs",
    "asr:benchmark": "node scripts/run-asr-benchmark.mjs",
    "asr:test": "node scripts/test-asr-validation.mjs",
    "platform:smoke": "node scripts/run-platform-smoke.mjs",
    "asr:evidence:check": "node scripts/check-asr-evidence.mjs",
    "desktop:dev": "pnpm --dir apps/desktop dev",
    "desktop:dev:web": "pnpm --dir apps/desktop dev:web",
    "desktop:test": "pnpm --dir apps/desktop test",
    "desktop:typecheck": "pnpm --dir apps/desktop typecheck",
    "desktop:check": "pnpm --dir apps/desktop check",
    "desktop:build:web": "pnpm --dir apps/desktop build:web",
    "desktop:build": "pnpm --dir apps/desktop build",
    "desktop:tauri": "pnpm --dir apps/desktop tauri",
    "python:bootstrap": "node scripts/bootstrap-python-dev.mjs",
    "python:lint": "node scripts/run-python-dev.mjs lint",
    "python:test": "node scripts/run-python-dev.mjs test",
    "redeem-key:keypair": "node scripts/redeem-key.mjs keypair",
    "redeem-key:generate": "node scripts/redeem-key.mjs generate",
    "release:check-platforms": "node scripts/check-platform-matrix.mjs",
    "release:check-security": "node scripts/check-security-baseline.mjs",
    "release:check-runtime-locks": "node scripts/check-runtime-locks.mjs",
    "release:check-versions": "node scripts/check-version-consistency.mjs",
    "release:check": "pnpm release:check-versions && pnpm release:check-platforms && pnpm release:check-security && pnpm release:check-runtime-locks && pnpm security:test && pnpm asr:test",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:test": "cargo test --workspace",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:check": "pnpm release:check && pnpm rust:fmt:check && pnpm rust:test && pnpm rust:clippy"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4"
  }
}

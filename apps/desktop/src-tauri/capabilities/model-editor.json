{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "model-editor-capability",
  "description": "Model editor can manage AI model records and UI preferences only.",
  "windows": ["model-editor"],
  "permissions": [
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "allow-destroy-current-window",
    "allow-set-current-window-theme",
    "allow-set-current-window-title",
    "allow-get-ui-preferences",
    "allow-list-ai-models",
    "allow-save-ai-model",
    "allow-delete-ai-model"
  ]
}

{
  "name": "@liberty/desktop",
  "private": true,
  "version": "1.1.2",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "check": "pnpm run typecheck && pnpm run build:web",
    "prepare:runtime-bundle:if-missing": "node ../../scripts/prepare-runtime-bundle.mjs --if-missing",
    "dev": "pnpm run prepare:runtime-bundle:if-missing && pnpm run dev:web",
    "build:web": "tsc -p tsconfig.app.json --noEmit && vite build",
    "prepare:runtime-bundle": "node ../../scripts/prepare-runtime-bundle.mjs",
    "build": "pnpm run prepare:runtime-bundle && pnpm run build:web",
    "preview": "vite preview",
    "tauri": "node ../../scripts/run-tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@iconify-json/f7": "^1.2.2",
    "@iconify/utils": "^3.1.3",
    "@tauri-apps/cli": "2.11.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
